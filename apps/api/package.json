{
  "name": "@dit/api",
  "version": "0.0.0",
  "private": true,
  "description": "Dev-in.tw API and DNS sync worker (Hono on Node 24)",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/main.ts",
    "build": "tsdown",
    "start": "node --enable-source-maps dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@dit/contract": "workspace:*",
    "@dit/dns": "workspace:*",
    "@hono/node-server": "^2.1.5",
    "@scalar/hono-api-reference": "^0.12.14",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "pino": "^10.4.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
