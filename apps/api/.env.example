# Dev-in.tw API — local development only. In production every value is injected from Infisical
# (project "Dev-in.tw", Dokploy vault provider `dev-in-tw`). Never commit a real secret.
# The API validates this list with zod at startup and refuses to start when something is missing
# or dangerous (see apps/api/src/config.ts and docs/PLAN.md §3.13 / §7).

# ── Runtime ─────────────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=debug
# Origin of the website; CSRF compares Origin against it exactly. Production: https://dev-in.tw
APP_ORIGIN=http://localhost:3000
# Number of trusted reverse proxies in front of the API (Traefik = 1). 0 = use the socket address.
TRUSTED_PROXY_HOPS=1
# false disables every rate limit (local Playwright / e2e only). Production refuses false.
RATE_LIMIT_ENABLED=true

# ── Database (PostgreSQL 18; `docker compose -f compose.dev.yml up -d`) ─────────────────────────
DATABASE_URL=postgres://dit:dit@127.0.0.1:5432/dit

# ── Sessions and GitHub OAuth ───────────────────────────────────────────────────────────────────
# HMAC key for the OAuth state cookie: at least 32 random characters (openssl rand -base64 48)
SESSION_SECRET=change-me-to-at-least-32-random-characters
# Required unless AUTH_DEV_LOGIN=true (and always required in production)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback
# Comma-separated GitHub numeric ids that become admins on login (owner decision §7: HACO8888)
ADMIN_GITHUB_IDS=51485352
# POST /api/v1/auth/dev-login with a fake GitHub identity. Refused in production and with DNS_PROVIDER=cloudflare.
AUTH_DEV_LOGIN=true

# ── DNS ─────────────────────────────────────────────────────────────────────────────────────────
ROOT_DOMAIN=dev-in.tw
# memory (default outside production) | cloudflare (default in production)
DNS_PROVIDER=memory
# Required when DNS_PROVIDER=cloudflare. Token scope: Zone:DNS:Edit + Zone:Read on dev-in.tw only, with Client IP filtering.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# Client-side rate limit for Cloudflare calls (CF allows 1,200 req / 5 min per account)
CLOUDFLARE_RPS=3
# dev-in.tw is a Free zone created 2023-05-11 → 1,000 records (§7)
ZONE_RECORD_LIMIT=1000
ZONE_HEADROOM=20
# Relative to ROOT_DOMAIN; the reconciler and the worker never touch these
SYSTEM_RECORD_NAMES=@,www,api,_dmarc,_psl,mail
ALLOWED_RECORD_TYPES=A,AAAA,CNAME,TXT,MX,SRV,CAA

# ── Quotas and naming (§7: 2 subdomains per user, 10 records per subdomain) ─────────────────────
MAX_SUBDOMAINS_PER_USER=2
MAX_RECORDS_PER_SUBDOMAIN=10
MIN_GITHUB_ACCOUNT_AGE_DAYS=30
NAME_COOLDOWN_DAYS=30
# Optional: file with one offensive name per line (kept out of the public repo, mounted as a secret)
RESERVED_PRIVATE_SEED_FILE=

# ── Abuse protection ────────────────────────────────────────────────────────────────────────────
# Cloudflare Turnstile test keys (always pass). Production refuses the test secret.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Defaults to the hostname of APP_ORIGIN; not checked for the test keys
TURNSTILE_EXPECTED_HOSTNAME=
# Salt for hashing reporter IPs and log IPs (random, at least 8 characters)
REPORT_IP_SALT=change-me-random-salt

# ── Background jobs ─────────────────────────────────────────────────────────────────────────────
WORKER_ENABLED=true
# 0 disables the periodic reconcile
RECONCILE_INTERVAL_SECONDS=600
# Mass-delete brake: a reconcile that would delete more orphans than this (or > 10% of managed records) aborts
RECONCILE_MAX_ORPHAN_DELETES=10

# ── Alerts and observability ────────────────────────────────────────────────────────────────────
# Discord webhook for admin alerts (embed format). Empty = alerts only go to the log.
DISCORD_WEBHOOK_URL=
# Accepted but not implemented yet (the API logs a warning when set)
SENTRY_DSN=
METRICS_ENABLED=false
METRICS_PORT=9464

# ── Public links returned by GET /api/v1/meta ───────────────────────────────────────────────────
PUBLIC_GITHUB_URL=https://github.com/Dev-in-tw
PUBLIC_DISCORD_URL=
