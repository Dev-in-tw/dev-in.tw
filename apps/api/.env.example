SESSION_SECRET=change-me-to-at-least-32-random-bytes
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/api/v1/auth/github/callback
ADMIN_GITHUB_IDS=51485352
ROOT_DOMAIN=dev-in.tw
DNS_PROVIDER=memory
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
ZONE_RECORD_LIMIT=1000
ZONE_HEADROOM=20
SYSTEM_RECORD_NAMES=@,www,api,_dmarc,_psl,mail
MAX_SUBDOMAINS_PER_USER=2
MAX_RECORDS_PER_SUBDOMAIN=10
MIN_GITHUB_ACCOUNT_AGE_DAYS=30
NAME_COOLDOWN_DAYS=30
RECONCILE_MAX_ORPHAN_DELETES=10
