# Local development only. In production every value is injected from Infisical (project "Dev-in.tw").
# Never commit a real secret. Full list and meaning: docs/PLAN.md §3.13.
NODE_ENV=development
PORT=3001
APP_ORIGIN=http://localhost:3000
